{
    "name":  "home-manager",
    "version":  "0.1.0",
    "description":  "Home Manager - gestionale desktop della casa",
    "keywords":  [

                 ],
    "author": "Andrea Pollastrelli",
    "license":  "ISC",
    "dependencies":  {
                         "dexie":  "^4.4.7",
                         "dexie-react-hooks":  "^4.4.0",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
                         "react-router-dom":  "^7.18.5"
                     },
    "devDependencies":  {
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.2.1",
                            "autoprefixer":  "^10.6.2",
                            "electron":  "^45.2.3",
                            "electron-builder":  "^26.18.0",
                            "postcss":  "^8.5.32",
                            "tailwindcss":  "^3.4.19",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.3.6"
                        },
    "main":  "electron/main.cjs",
    "scripts":  {
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "pack":  "npm run build \u0026\u0026 electron-builder --win --dir"
                },
    "build":  {
                  "appId":  "local.homemanager",
                  "productName":  "Home Manager",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**",
                                "electron/**",
                                "server/**",
                                "package.json"
                            ],
                  "win":  {
                              "target":  "dir",
                              "signAndEditExecutable":  false
                          }
              },
    "type":  "module"
}